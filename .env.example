# --- GitHub (приватный репозиторий с database.json) ---
# Fine-grained Personal Access Token с доступом ТОЛЬКО к этому репозиторию,
# right: Contents -> Read and write
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-private-repo-name
GITHUB_FILE_PATH=database.json
GITHUB_BRANCH=main

# --- Админ-панель ---
# Длинный случайный секрет, которым защищены все /api/admin/* эндпоинты.
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-secret
